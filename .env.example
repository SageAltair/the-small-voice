# =============================================================================
# The Small Voice — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/the_small_voice

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# Admin account (created automatically on first startup)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-admin-password

# -----------------------------------------------------------------------------
# Google OAuth (optional — enables "Continue with Google" sign-in)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# -----------------------------------------------------------------------------
# Frontend URL (used for OAuth callbacks and email links)
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://the-small-voice-frontend.onrender.com

# Regular expression for browser Origin header (optional).
# FRONTEND_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# Email (SMTP) — used for verification emails and contact form
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=The Small Voice
SMTP_FROM_EMAIL=your-email@gmail.com

# Inbox that receives contact form submissions
CONTACT_EMAIL=your-email@gmail.com

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
# UPLOAD_DIR is set automatically relative to the backend directory.
# MAX_UPLOAD_SIZE_MB=10
